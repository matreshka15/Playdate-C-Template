{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "detail": "构建游戏 (生成 .pdx 包)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.ps1",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Build & Run",
            "detail": "构建并在模拟器中运行",
            "type": "shell",
            "command": "${workspaceFolder}\\build.ps1",
            "args": ["-Run"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean",
            "detail": "清理构建产物",
            "type": "shell",
            "command": "${workspaceFolder}\\build.ps1",
            "args": ["-Clean"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Setup",
            "detail": "运行配置向导 (首次使用必跑)",
            "type": "shell",
            "command": "${workspaceFolder}\\setup.ps1",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Check Environment",
            "detail": "检查开发环境状态",
            "type": "shell",
            "command": "${workspaceFolder}\\setup.ps1",
            "args": ["-Mode", "check"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}

